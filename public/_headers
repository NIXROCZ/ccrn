/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/video/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/downloads
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/cart
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
