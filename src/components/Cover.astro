---
import type { Kit } from '../lib/catalogue';
const { kit } = Astro.props as { kit: Kit };
const lines = kit.coverTitle.toUpperCase().split(' ');
const midpoint = Math.ceil(lines.length / 2);
const line1 = lines.length > 1 && kit.coverTitle.length > 9 ? lines.slice(0, midpoint).join(' ') : kit.coverTitle.toUpperCase();
const line2 = lines.length > 1 && kit.coverTitle.length > 9 ? lines.slice(midpoint).join(' ') : '';
const size = Math.min(74, 640 / Math.max(line1.length, line2.length || 1) * 1.55);
---
<svg viewBox="0 0 1000 1000" role="img" aria-label={`${kit.title} cover`} xmlns="http://www.w3.org/2000/svg">
  <rect width="1000" height="1000" fill="#fff"/>
  <circle cx="500" cy="500" r="468" fill="#f6f4ec"/>
  <text x="500" y="212" text-anchor="middle" font-family="Jost,sans-serif" font-size="27" letter-spacing="4" fill="#5a6855">RAISING NOBLE</text>
  <text x="500" y="252" text-anchor="middle" font-family="Cormorant Garamond,serif" font-size="25" letter-spacing="1.6" fill="#5a6855">{kit.cat.toUpperCase()}</text>
  <text x="500" y={line2 ? 300 : 322} text-anchor="middle" font-family="Cormorant Garamond,serif" font-weight="500" font-size={size} letter-spacing="9" fill="#4e6049">{line1}</text>
  {line2 && <text x="500" y="380" text-anchor="middle" font-family="Cormorant Garamond,serif" font-weight="500" font-size={size} letter-spacing="9" fill="#4e6049">{line2}</text>}
  <circle cx="500" cy={line2 ? 545 : 500} r="84" fill="none" stroke="#879581" stroke-width="4"/>
  <path d={kit.motif === 'water' ? 'M430 545q70-70 140 0t140 0' : kit.motif === 'shield' ? 'M500 455l75 30v65q0 65-75 95-75-30-75-95v-65z' : 'M500 455c-38 48-58 88-58 120a58 58 0 00116 0c0-32-20-72-58-120z'} fill="none" stroke="#879581" stroke-width="5"/>
  <text x="500" y="812" text-anchor="middle" font-family="Jost,sans-serif" font-size="19" fill="#8b9187">{kit.coverLine1}</text>
  <text x="500" y="838" text-anchor="middle" font-family="Jost,sans-serif" font-size="19" fill="#8b9187">{kit.coverLine2}</text>
</svg>
