---
/**
 * A generated kit cover.
 *
 * Replaces the previous three-shape version (water / shield / a leaf for
 * everything else), which rendered nearly every kit as the same circle. Each
 * kit now has its own mark, drawn in the brand's palette, so the shop grid
 * reads as fifteen products rather than one repeated tile.
 */
import type { Kit } from '../lib/catalogue';
import { coverSvgForKit } from '../lib/covers';
import { categories } from '../data/collections';

const { kit } = Astro.props as { kit: Kit };
const collectionName = categories.find((category) => category.id === kit.cat)?.collection ?? '';
const svg = coverSvgForKit(kit, collectionName);
---
<Fragment set:html={svg} />
