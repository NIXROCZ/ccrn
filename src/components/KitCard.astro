---
import type { Kit } from '../lib/catalogue';
import Cover from './Cover.astro';
import { categoryLabel } from '../lib/catalogue';
import { formatAud, KIT_PRICE_CENTS } from '../lib/pricing';

const { kit, eager = false } = Astro.props as { kit: Kit; eager?: boolean };
const available = kit.status === 'available';
---
<article class="card" data-reveal data-cat={kit.cat} data-min={kit.ages.min} data-max={kit.ages.max}>
  <a class="card-link" href={`/kits/${kit.id}`}>
    <span class="card-media">
      {!available && <span class="ribbon">Coming soon</span>}
      {
        kit.cover ? (
          <img src={kit.cover} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        ) : kit.realCover ? (
          <img src="/covers/seedoils.jpg" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        ) : (
          <Cover kit={kit} />
        )
      }
    </span>
    <span class="card-body">
      <span class="meta">{categoryLabel(kit.cat)}</span>
      <span class="card-title">{kit.title}</span>
      <span class="ages">Ages {kit.ages.min}&ndash;{kit.ages.max}</span>
      <span class="desc">{available ? formatAud(KIT_PRICE_CENTS).replace('.00', '') : 'Coming soon'}</span>
    </span>
  </a>
</article>
