---
/** Five stars, decorative — the rating is carried by the quote itself. */
---
<div class="stars" aria-hidden="true">
  {
    Array.from({ length: 5 }).map(() => (
      <svg viewBox="0 0 24 24">
        <path d="M12 2l3 6.9 7.5.7-5.6 5 1.6 7.4L12 18.3 5.5 22l1.6-7.4-5.6-5 7.5-.7z" />
      </svg>
    ))
  }
</div>
