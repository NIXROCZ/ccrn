---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Raising Noble">
  <section class="wrap sec"><div class="phead"><p class="kicker">Get in touch</p><h1 class="h1">Contact</h1><p class="lede narrow center">We aim to reply within a few days.</p></div><form class="form-grid" data-endpoint="/api/contact"><div class="field"><label for="name">Name</label><input id="name" name="name" required></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required></div><div class="field"><label for="topic">Topic</label><select id="topic" name="topic"><option>Question about a kit</option><option>Download or payment</option><option>Correction</option><option>Other</option></select></div><div class="field"><label for="message">Message</label><textarea id="message" name="message" required></textarea></div><div class="sr"><label for="website">Leave this blank</label><input id="website" name="website"></div><div id="turnstile-widget"></div><button class="btn" type="submit">Send message</button></form></section>
</Layout>
