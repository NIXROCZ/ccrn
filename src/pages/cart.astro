---
import Layout from '../layouts/Layout.astro';
import { getKits, formatAud } from '../lib/catalogue';
import { KIT_PRICE_CENTS } from '../lib/pricing';
const kits = getKits();
---
<Layout title="Your cart | Raising Noble">
  <section class="wrap sec"><div class="phead"><p class="kicker">Your basket</p><h1 class="h1">Cart</h1></div><div class="cart-table" id="cart-lines">{kits.map((kit) => <div class="cart-line" data-cart-line={kit.id} hidden><span>{kit.title}</span><span>{formatAud(KIT_PRICE_CENTS)} <button class="tlink" type="button">Remove</button></span></div>)}<div id="gift-cart-lines"></div></div><div class="narrow sec-s"><h2 class="h3">Gift codes</h2><form id="gift-code-form" class="inline-form" data-endpoint="/api/gift/check"><label class="sr-only" for="cart-gift-code">Gift card code</label><input id="cart-gift-code" name="code" placeholder="Enter a gift card code"><button class="btn ghost" type="submit">Apply</button></form><p class="muted">Up to three gift codes can be applied.</p></div><div class="totals"><div class="total-row"><span>Subtotal</span><span id="cart-subtotal">A$0</span></div><div class="total-row"><span>Bundle discount</span><span id="cart-discount">A$0</span></div><div class="total-row"><span>Gift card credit</span><span id="cart-credit">A$0</span></div><div class="total-row grand"><span>Total</span><span id="cart-total">A$0</span></div><form id="checkout-form"><div class="field"><label for="checkout-email">Email for delivery</label><input id="checkout-email" name="email" type="email" required></div><button class="btn full" type="submit">Checkout</button></form><p class="muted">Card, Apple Pay, Google Pay and Link. We deliver worldwide. Prices are in Australian dollars; if your card is in another currency your bank converts at its own rate.</p></div></section>
</Layout>
