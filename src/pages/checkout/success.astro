---
import Layout from '../../layouts/Layout.astro';
import { dbFirst } from '../../lib/server/db';
import { retrieveCheckoutSession } from '../../lib/server/stripe';
import { createSession } from '../../lib/server/session';
import { consumeSuccessToken, finalisePaidOrder } from '../../lib/server/orders';
import { getKit } from '../../lib/catalogue';
export const prerender = false;
const env = Astro.locals.runtime.env;
let email: string | null = null;
let orderId = Astro.url.searchParams.get('order');
const oneTime = Astro.url.searchParams.get('t');
if (oneTime) {
  const tokenData = await consumeSuccessToken(env, oneTime);
  if (tokenData) { email = tokenData.email; orderId = tokenData.orderId; }
}
let session;
if (!email && Astro.url.searchParams.get('session_id')) {
  session = await retrieveCheckoutSession(env, Astro.url.searchParams.get('session_id') ?? '').catch(() => undefined);
  email = session?.customer_details?.email ?? null;
  orderId = orderId ?? session?.metadata?.order_id ?? session?.client_reference_id ?? null;
  if (session?.payment_status === 'paid' && orderId) await finalisePaidOrder(env, orderId, session);
}
if (email) Astro.cookies.set('__Host-rn_session', await createSession(env, email), { httpOnly: true, secure: true, sameSite: 'lax', path: '/', maxAge: 60 * 60 * 24 * 30 });
const order = orderId ? await dbFirst<{ status: string; order_number: string; items_json: string }>(env, 'SELECT status, order_number, items_json FROM orders WHERE id = ?', orderId) : null;
const items = order ? JSON.parse(order.items_json) as { kits: string[] } : { kits: [] };
const missingOrder = Boolean((Astro.url.searchParams.get('session_id') && !session) || (orderId && !order));
---
<Layout title="Order received | Raising Noble"><section class="wrap sec center">{missingOrder ? <><h1 class="h1">We couldn't find that order.</h1><p class="lede narrow center">Check your email or use <a class="tlink" href="/downloads">/downloads</a> to access your purchase.</p></> : order?.status === 'paid' ? <><h1 class="h1">Thank you.</h1><p class="lede narrow center">Your order {order.order_number} is ready.</p><div class="narrow">{items.kits.map((kitId) => <p><a class="tlink" href={`/api/download/${kitId}`}>Download {getKit(kitId)?.title ?? kitId}</a></p>)}</div><a class="btn" href="/downloads">Go to downloads</a></> : <><h1 class="h1">Payment processing.</h1><p class="lede narrow center">Your payment is still being confirmed. This page will refresh shortly.</p><meta http-equiv="refresh" content="5"></>}</section></Layout>
