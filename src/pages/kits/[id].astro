---
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import KitCard from '../../components/KitCard.astro';
import { getKits, categoryLabel } from '../../lib/catalogue';
import { formatAud, BUNDLE_SIZE, BUNDLE_PRICE_CENTS, KIT_PRICE_CENTS } from '../../lib/pricing';
import { testimonialsFor } from '../../data/testimonials';
import { supportLines, telHref } from '../../data/support';

export function getStaticPaths() {
  return getKits().map((kit) => ({ params: { id: kit.id }, props: { kit } }));
}

const { kit } = Astro.props;
const available = kit.status === 'available';
/* Same collection first: someone reading about seed oils is more likely to
   want another food kit than a random one. */
const others = getKits().filter((other) => other.id !== kit.id);
const related = [...others.filter((other) => other.cat === kit.cat), ...others.filter((other) => other.cat !== kit.cat)].slice(0, 4);
const quotes = testimonialsFor(kit.id);

const pillars = [
  { title: 'Simple & engaging', body: 'Written in the gentle, educational style of Raising Noble, so learning stays simple, warm and genuinely interesting.' },
  { title: 'Fact over fear', body: 'No complicated rules and no fear-based messaging. Honest, practical guidance that builds understanding rather than alarm.' },
  { title: 'Learn, then do', body: 'Reflection exercises and activities that bring a family closer while teaching something that carries into everyday life.' },
];

const instructions = [
  'Unzip the file.',
  'Read the parent and carer guide first.',
  'Watch the presentation together on a laptop, tablet or TV.',
  'Talk through the ideas and the questions.',
  'Print and complete the activities together.',
  'Keep returning to it in everyday family life.',
];
---
<Layout title={`${kit.title} | Raising Noble`} description={kit.blurb}>
  <section class="wrap sec-t">
    <div class="pdp">
      <div class="pdp-media">
        <figure class="cover">
          {
            kit.cover ? <img src={kit.cover} alt={`${kit.title} cover`} />
            : kit.realCover ? <img src={`/covers/${kit.id}.jpg`} alt={`${kit.title} cover`} />
            : <Cover kit={kit} />
          }
        </figure>
      </div>

      <div>
        <p class="pdp-collection"><em>Collection:</em> <a class="inline-link" href={`/shop?c=${kit.cat}`}>{categoryLabel(kit.cat)}</a></p>
        <h1>{kit.title}</h1>

        <div class="pdp-meta">
          <span class="pill">Ages {kit.ages.min}–{kit.ages.max}</span>
          <span class="pill">{kit.files.length} files</span>
          {!available && <span class="pill">Coming soon</span>}
        </div>

        {
          available ? (
            <>
              <div class="pdp-price"><span class="amt">{formatAud(KIT_PRICE_CENTS)} AUD</span></div>
              <div class="pdp-buy"><button class="btn add-kit" data-kit={kit.id}>Add to cart</button></div>
            </>
          ) : (
            <div class="soon-note">
              <strong>This kit is still being written.</strong>
              <p class="mt-sm">
                We publish a kit when it is finished and checked, not to a schedule.
              </p>
              <p class="mt-md">
                <button class="btn ghost sm notify-kit" data-kit={kit.id}>Notify me when it is ready</button>
              </p>
            </div>
          )
        }

        <div class="tabs" data-tabs role="tablist" aria-label="Kit details" data-needs-js>
          <button role="tab" id="tab-desc" aria-controls="panel-desc" aria-selected="true">Description</button>
          <button role="tab" id="tab-incl" aria-controls="panel-incl" aria-selected="false" tabindex="-1">What's included</button>
          <button role="tab" id="tab-inst" aria-controls="panel-inst" aria-selected="false" tabindex="-1">Instructions</button>
        </div>

        <div class="tabbody">
          <div id="panel-desc" role="tabpanel" aria-labelledby="tab-desc" tabindex="0">
            <p>{kit.blurb}</p>
            <p class="mt-md">
              Written in the gentle, educational style of Raising Noble: no complicated rules and no
              fear-based messaging, just honest, practical guidance that builds understanding.
            </p>
          </div>
          <div id="panel-incl" role="tabpanel" aria-labelledby="tab-incl" tabindex="0">
            <h4>This kit includes</h4>
            <ul class="file-list">{kit.files.map((file) => <li>{file}</li>)}</ul>
          </div>
          <div id="panel-inst" role="tabpanel" aria-labelledby="tab-inst" tabindex="0">
            <h4>How to use your kit</h4>
            <ol>{instructions.map((step) => <li>{step}</li>)}</ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="learn-split">
      <MediaSlot src="/images/family-time.webp" alt="A parent and toddler sorting fruit together." ratio="square" zoom />
      <div>
        <h2 class="h2 mb-sm">What you'll learn</h2>
        <dl class="learn">
          {kit.learn.map(([title, text]) => (<><dt>{title}</dt><dd>{text}</dd></>))}
        </dl>
      </div>
    </div>
  </section>

  {
    kit.sensitive && (
      <section class="wrap sec-b">
        <div class="narrow">
          <div class="support">
            <strong>If a child discloses something</strong>
            <p class="mt-sm">
              Listen calmly and reassure them they did the right thing by telling you. These services
              are free and confidential, and several are open at any hour.
            </p>
            <div class="services mt-md">
              {supportLines.map((line) => (
                <div class="service">
                  <div><h3>{line.name}</h3><p>{line.detail}</p></div>
                  <span class="num"><a href={telHref(line.number)}>{line.number}</a></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap sec-b">
    <div class="pillars">
      {
        pillars.map((pillar) => (
          <div class="pillar" data-reveal>
            <div class="body">
              <h4>{pillar.title}</h4>
              <p>{pillar.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band band-soft">
    <div class="wrap sec">
      <div class="split">
        <MediaSlot src="/images/home-children.webp" alt="Two children sitting together with a picture book." ratio="wide" zoom />
        <div>
          <p class="kicker">Time well spent</p>
          <h2 class="h2 mb-sm">More Than Just Family Time</h2>
          <p>A kit is not a worksheet to get through. It is an hour where everyone is pointed at the same thing, and the questions come from the children rather than the adults.</p>
          <p class="mt-md">Read the guide first, watch the presentation together, then let the conversation go where it goes. The activities are there for afterwards, not as homework.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="phead">
      <p class="kicker">Yours to keep</p>
      <h2 class="h2">Tools &amp; Memories to Keep</h2>
      <p class="lede narrow center">Downloaded once, printed as often as you like, and revisited whenever a child is ready for it again.</p>
    </div>
    <div class="four">
      {kit.files.map((file) => (
        <div class="keep reveal">
          <h3 class="h4">{file.replace(' (PDF)', '')}</h3>
          <p class="muted">PDF</p>
        </div>
      ))}
      <div class="keep keep-note reveal">
        <h3 class="h4">Add two more</h3>
        <p class="muted">Any three kits together are {formatAud(BUNDLE_PRICE_CENTS)} instead of {formatAud(BUNDLE_SIZE * KIT_PRICE_CENTS)}.</p>
        <p><a class="inline-link" href="/bundle">Build a bundle</a></p>
      </div>
    </div>
  </section>

  {quotes.length > 0 && (
    <section class="wrap sec-b">
      <div class="phead"><p class="kicker">In their words</p><h2 class="h2">What Families Are Saying</h2></div>
      <div class="quotes">
        {quotes.map((entry) => (
          <figure class="quote reveal">
            <blockquote>{entry.quote}</blockquote>
            <figcaption>{entry.who}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="wrap sec-b">
    <p class="section-title center">
      Discover More Together
    </p>
    <div class="cards">{related.map((other, index) => <KitCard kit={other} order={index} />)}</div>
  </section>
</Layout>
