---
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import KitCard from '../../components/KitCard.astro';
import Testimonials from '../../components/Testimonials.astro';
import { getKits, categoryLabel } from '../../lib/catalogue';
import { formatAud, KIT_PRICE_CENTS } from '../../lib/pricing';

export function getStaticPaths() {
  return getKits().map((kit) => ({ params: { id: kit.id }, props: { kit } }));
}

const { kit } = Astro.props;
const available = kit.status === 'available';
const related = getKits().filter((other) => other.id !== kit.id).slice(0, 4);
const pillars = [
  { title: 'Simple & Engaging', body: 'Created in the gentle, educational style of Raising Noble, this guide makes learning simple, fun and engaging.' },
  { title: 'Fun over Fear', body: 'No complicated rules and no fear-based messaging. Just honest, practical guidance that builds critical thinking and understanding.' },
  { title: 'Learn then Do Approach', body: 'Discover reflection exercises and activities that bring your family closer while teaching life-applicable lessons.' },
];
const instructions = [
  'Unzip the zip file.',
  'Read the Parent Guide first.',
  'Watch the PPT or PDF presentation together.',
  'Talk through the ideas and questions.',
  'Print and complete the activities together.',
  'Keep exploring the topic in everyday family life.',
];
---
<Layout title={`${kit.title} | Raising Noble`} description={kit.blurb}>
  <section class="wrap sec-t">
    <div class="pdp">
      <div class="pdp-media">
        <figure class="cover">
          {kit.cover ? <img src={kit.cover} alt={`${kit.title} cover`} /> : kit.realCover ? <img src="/covers/seedoils.jpg" alt={`${kit.title} cover`} /> : <Cover kit={kit} />}
        </figure>
      </div>
      <div>
        <p class="pdp-collection">{categoryLabel(kit.cat)}</p>
        <h1>{kit.title}</h1>
        <p class="product-age">Ages {kit.ages.min}–{kit.ages.max}</p>
        {
          available ? (
            <>
              <div class="pdp-price"><span class="amt">{formatAud(KIT_PRICE_CENTS)} AUD</span></div>
              <div class="pdp-buy">
                <div class="qty" title="One licence per household">
                  <button type="button" disabled aria-label="Decrease quantity">−</button>
                  <output aria-label="Quantity">1</output>
                  <button type="button" disabled aria-label="Increase quantity">+</button>
                </div>
                <button class="btn add-kit" data-kit={kit.id} aria-label="Add to cart — one licence per household">Add to cart</button>
              </div>
            </>
          ) : (
            <div class="soon-note">
              <strong>This kit is still being written.</strong>
              <p class="mt-sm">We publish a kit when it is finished and checked, not to a schedule.</p>
              <p class="mt-md"><button class="btn ghost sm notify-kit" data-kit={kit.id}>Notify me when it is ready</button></p>
            </div>
          )
        }
        <div class="tabs" data-tabs role="tablist" aria-label="Kit details" data-needs-js>
          <button role="tab" id="tab-desc" aria-controls="panel-desc" aria-selected="true">Description</button>
          <button role="tab" id="tab-incl" aria-controls="panel-incl" aria-selected="false" tabindex="-1">What's included</button>
          <button role="tab" id="tab-inst" aria-controls="panel-inst" aria-selected="false" tabindex="-1">Instructions</button>
        </div>
        <div class="tabbody">
          <div id="panel-desc" role="tabpanel" aria-labelledby="tab-desc" tabindex="0">
            <p>{kit.blurb}</p>
            <p class="mt-md">With engaging activities designed to be explored together, it transforms an everyday topic into a meaningful family moment.</p>
            <ul class="feature-list">
              <li>Instant download</li><li>Thoughtfully designed for families</li><li>Child-friendly presentation</li><li>Includes printable activities</li><li>Learn together, at your own pace</li>
            </ul>
          </div>
          <div id="panel-incl" role="tabpanel" aria-labelledby="tab-incl" tabindex="0">
            <h4>This kit includes</h4>
            <ul class="file-list">
              <li>Presentation (PPT)</li><li>PDF version</li><li>Printable activities x2</li><li>Parent &amp; Carer Guide</li><li>Viewing Guide</li>
            </ul>
            <h4>More information on what's inside</h4>
            <p><strong>Presentation (PPT):</strong> Designed for viewing together on a TV, computer or tablet.</p>
            <p><strong>PDF version:</strong> An easy-to-view alternative to the PowerPoint.</p>
            <p><strong>Printable activities:</strong> Hands-on activities to reinforce learning.</p>
            <p><strong>Parent &amp; Carer Guide:</strong> Background information, conversation prompts and practical tips.</p>
            <p><strong>Viewing Guide:</strong> Simple tips to help you get started.</p>
          </div>
          <div id="panel-inst" role="tabpanel" aria-labelledby="tab-inst" tabindex="0">
            <h4>How to use your kit</h4>
            <ol>{instructions.map((step) => <li>{step}</li>)}</ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="center mb-lg"><p class="kicker">What you'll learn</p><h2 class="h2">What You'll Learn</h2></div>
    <div class="product-learn">
      {kit.learn.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </section>

  <section class="sage-pillars">
    <div class="pillars">
      {pillars.map((pillar) => <article class="pillar"><div class="body"><h4>{pillar.title}</h4><p>{pillar.body}</p></div></article>)}
    </div>
  </section>

  <section class="wrap sec">
    <div class="feature-blocks">
      <article class="feature-block">
        <div class="feature-image"><img src="/images/family-time.webp" alt="A family spending meaningful time together." /></div>
        <div><h2>More Than Just Family Time</h2><p>Move beyond passive entertainment and make screen-time meaningful and creative. Create moments to connect, learn and grow together.</p></div>
      </article>
      <article class="feature-block reverse">
        <div class="feature-image"><img src="/images/library-what.webp" alt="Family learning materials arranged on a table." /></div>
        <div><h2>Tools &amp; Memories to Keep</h2><p>Give children the knowledge and confidence to navigate the world, while creating meaningful moments together along the way.</p></div>
      </article>
    </div>
  </section>

  {
    kit.sensitive && (
      <section class="wrap sec-b">
        <div class="narrow">
          <div class="support">
            <strong>If a child discloses something</strong>
            <p class="mt-sm">
              Listen calmly and reassure them they did the right thing by telling you. These services
              are free and confidential, and several are open at any hour.
            </p>
            <div class="services mt-md">
              <div class="service"><div><h3>Emergency</h3><p>If a child is in immediate danger.</p></div><span class="num"><a href="tel:000">000</a></span></div>
              <div class="service"><div><h3>Kids Helpline</h3><p>Free counselling for young people aged 5 to 25, any hour.</p></div><span class="num"><a href="tel:1800551800">1800 55 1800</a></span></div>
              <div class="service"><div><h3>1800RESPECT</h3><p>Sexual assault, domestic and family violence counselling.</p></div><span class="num"><a href="tel:1800737732">1800 737 732</a></span></div>
              <div class="service"><div><h3>Parentline NSW</h3><p>Support for parents and carers in New South Wales.</p></div><span class="num"><a href="tel:1300130052">1300 1300 52</a></span></div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <Testimonials title="What families are saying" />
  <section class="wrap sec-b">
    <p class="section-title center">Discover more together</p>
    <div class="cards">{related.map((other) => <KitCard kit={other} />)}</div>
  </section>
</Layout>
