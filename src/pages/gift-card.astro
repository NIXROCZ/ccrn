---
import Layout from '../layouts/Layout.astro';
import { GIFT_PRESETS_CENTS, GIFT_VALIDITY_YEARS, formatAud } from '../lib/pricing';
const benefits = [
  'Valid for three years from the date of purchase',
  'Spend it across any kit, or put it towards a bundle of three',
  'Any unused balance stays on the card',
  'Delivered by email, with your own message',
  'Choose a set amount, or name your own from A$10 to A$500',
];
---
<Layout title="Gift cards | Raising Noble">
  <section class="phero flat">
    <div class="wrap phero-in">
      <p class="kicker">A gift with meaning</p>
      <h1 class="h1">Give something worth keeping.</h1>
      <p class="lede narrow center">A Raising Noble gift card lets a family choose the conversation they are ready to have — and gives them the tools to have it well.</p>
    </div>
  </section>

  <section class="wrap sec gift-layout">
    <div class="gift-form-col">
      <h2 class="h2">Send a gift card</h2>
      <form class="form-grid" id="gift-form">
        <fieldset class="field">
          <legend>Choose an amount</legend>
          <div class="amounts">{GIFT_PRESETS_CENTS.map((amount) => <button type="button" class="filter gift-amount" data-amount={amount}>{formatAud(amount)}</button>)}</div>
        </fieldset>
        <div class="field"><label for="amount">Or enter your own (A$10&ndash;A$500)</label><input id="amount" name="amountCents" type="number" min="10" max="500" step="1" required></div>
        <div class="field"><label for="recipientName">Recipient name (optional)</label><input id="recipientName" name="recipientName"></div>
        <div class="field"><label for="recipientEmail">Recipient email (optional)</label><input id="recipientEmail" name="recipientEmail" type="email"><p class="hint">Leave this blank to have the card sent to you, so you can pass it on yourself.</p></div>
        <div class="field"><label for="message">Message (optional)</label><textarea id="message" name="message"></textarea></div>
        <button class="btn" type="submit">Add gift card to cart</button>
      </form>
    </div>

    <aside class="gift-aside">
      {/* The real card artwork, front and reverse. Hover (or focus, or a tap on
          a touch screen) flips to the reverse, which carries the three-year
          validity the law requires us to state. Both are always in the DOM so
          the second is not a surprise load on hover. */}
      <div class="gift-flip" tabindex="0" aria-label={`Raising Noble gift card, valid for ${GIFT_VALIDITY_YEARS} years`}>
        <img class="gift-flip-front" src="/images/gift-card-front.png" alt="" width="1063" height="650" loading="lazy" decoding="async" />
        <img class="gift-flip-back" src="/images/gift-card-reverse.png" alt="" width="1063" height="650" loading="lazy" decoding="async" />
      </div>
      <h3 class="h3">What is included</h3>
      <ul class="ticks">{benefits.map((benefit) => <li>{benefit}</li>)}</ul>
      <p class="muted">Not sure how to use one? Read the <a href="/gift-card/redeem">redemption instructions</a>.</p>
    </aside>
  </section>

  <section class="wrap sec-s" id="balance">
    <div class="narrow">
      <h2 class="h2">Check a balance</h2>
      <p class="muted">Enter a code to see what is left on it and when it expires.</p>
      <form class="form-grid" data-endpoint="/api/gift/check">
        <div class="field"><label for="giftCode">Gift card code</label><input id="giftCode" name="code" required></div>
        <button class="btn ghost" type="submit">Check balance</button>
      </form>
    </div>
  </section>
</Layout>
