---
import Layout from '../layouts/Layout.astro';
import KitCard from '../components/KitCard.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Testimonials from '../components/Testimonials.astro';
import { getKits, bundle } from '../lib/catalogue';
import { categories } from '../data/collections';

const kits = getKits();
const shelf = [...kits]
  .sort((a, b) => Number(b.status === 'available') - Number(a.status === 'available'))
  .slice(0, 4);
const safeStrong = categories.find((category) => category.id === 'safety');
const offer = bundle();
---
<Layout title="Raising Noble — for the conversations that matter">
  <section class="hero">
    <MediaSlot video="/video/hero.mp4" poster="/images/hero-poster.webp" alt="Sunlight moving through green leaves." ratio="fill" />
    <div class="hero-in">
      <p class="kicker">Thoughtful resources for curious families</p>
      <h1>For the conversations that matter</h1>
      <a class="btn light" href="/shop">Shop now</a>
    </div>
    <button class="film-ctrl" type="button" data-film-toggle=".hero" data-needs-js>Pause</button>
  </section>

  <section class="shelf sec">
    <div class="wrap">
      <p class="kicker center mb-md">Bestsellers</p>
      <div class="cards">
        {shelf.map((kit, index) => <KitCard kit={kit} eager={index < 2} />)}
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="split narrowL">
      <div>
        <h2 class="curious-heading">Raising curious <em>thinkers</em>.<br />Building connected <em>families</em>.</h2>
        <hr class="rule" />
        <p class="lede">
          Simple, thoughtful resources to help you turn everyday topics and life skills into meaningful family moments.
        </p>
        <p class="muted note">
          Each kit takes one subject a child will eventually ask about and gives you a presentation to watch together,
          printable activities and a parent guide with useful background and conversation prompts.
        </p>
        <p class="mt-lg"><a class="tlink" href="/about">Our story</a></p>
      </div>
      <MediaSlot class="art" src="/images/home-children.webp" alt="Children painting a large mural on a white wall." ratio="square" zoom />
    </div>
  </section>

  <Testimonials title="Loved by curious families" />

  {
    safeStrong && (
      <section class="panel collection-band">
        <MediaSlot src="/images/home-child.webp" alt="A child laughing in sunlight." ratio="fill" />
        <div class="panel-txt">
          <p class="kicker">New collection</p>
          <h2 class="h2">Safe &amp; <em>Strong</em></h2>
          <p>Bodies, boundaries, feelings and the online world. Staged gently by age, built on practice rather than warnings.</p>
          <a class="btn outline-light" href="/shop?c=safety">Explore the collection</a>
        </div>
      </section>
    )
  }

  <section class="conversation-band">
    <div class="narrow center">
      <h2>We believe some of the most important lessons begin with a conversation.</h2>
      <p>
        We are a couple in Wollongong who kept running out of good answers. So we started writing them down — the
        background, the questions worth asking and something to do together afterwards.
      </p>
    </div>
  </section>

  <section class="wrap sec">
    <div class="home-offers">
      <a class="offer-card offer-bundle" href="/bundle">
        <p class="kicker">Build your collection and save</p>
        <h2>Bundle and <em>Save</em></h2>
        <p>{offer.count >= 2 ? 'Take every published kit in one payment and save 30% on the collection.' : 'Every kit in one payment, at 30% off, as soon as the first ones are published.'}</p>
        <span class="tlink">Explore the bundle</span>
      </a>
      <a class="offer-card offer-gift" href="/gift-card">
        <MediaSlot src="/images/feat-gift.webp" alt="Wooden steps leading through greenery." ratio="square" />
        <span class="offer-card-copy">
          <p class="kicker">A thoughtful gift</p>
          <h2>Give a <em>Gift Card</em></h2>
          <span class="tlink">Give a gift card</span>
        </span>
      </a>
    </div>
  </section>

  <section class="shelf sec">
    <div class="wrap center">
      <p class="kicker mb-sm">Keep in touch</p>
      <h2 class="h2">Join Monthly Moments</h2>
      <p class="lede lede-centred">Simple tips, thoughtful conversations &amp; a little family activity, delivered each month.</p>
      <form class="inline-form mt-lg" data-endpoint="/api/newsletter">
        <label class="sr-only" for="home-newsletter-email">Email</label>
        <input id="home-newsletter-email" name="email" type="email" placeholder="Your email" required />
        <button class="btn" type="submit">Join</button>
      </form>
      <p class="muted mt-md text-xs">Double opt-in. Unsubscribe anytime.</p>
    </div>
  </section>
</Layout>
