---
import Layout from '../layouts/Layout.astro';
import KitCard from '../components/KitCard.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Testimonials from '../components/Testimonials.astro';
import { getKits } from '../lib/catalogue';
import { categories, ageBands } from '../data/collections';

const kits = getKits();
const countForAge = (min: number, max: number) => kits.filter((kit) => kit.ages.min <= max && kit.ages.max >= min).length;
---
<Layout title="Shop family education kits | Raising Noble">
  <section class="phero">
    <MediaSlot src="/images/shop-hero.webp" alt="Mesh produce bags with limes and ginger." ratio="fill" eager />
    <div class="phero-in">
      <h1>Shop All</h1>
      <p>Thoughtful resources for connected families</p>
    </div>
  </section>

  <div class="shop-filterbar">
    <div class="wrap shop-filterbar-inner">
      <nav class="collection-nav" aria-label="Filter by collection">
        <button class="filter" type="button" data-facet="cat" data-value="all" aria-pressed="true">Shop all</button>
        {categories.map((category) => (
          <>
            <span class="separator" aria-hidden="true">|</span>
            <button class="filter" type="button" data-facet="cat" data-value={category.id} aria-pressed="false">
              {category.collection}
            </button>
          </>
        ))}
      </nav>
      <div class="filter-tools">
        <button type="button" id="filter-toggle" aria-expanded="false" aria-controls="age-panel">Filter</button>
        <button type="button" id="sort-toggle" aria-expanded="false" aria-controls="sort-panel">Sort</button>
      </div>
      <div class="filter-panel" id="age-panel">
        <div>
          <p class="kicker mb-sm">Age</p>
          <div class="filter-options">
            <label class="filter-option"><input type="radio" name="shop-age" value="all" data-facet="age" checked /> All ages</label>
            {ageBands.map((band) => (
              <label class="filter-option">
                <input type="radio" name="shop-age" value={band.id} data-facet="age" data-min={band.min} data-max={band.max} />
                {band.label} <span class="muted">({countForAge(band.min, band.max)})</span>
              </label>
            ))}
          </div>
        </div>
        <div class="sort-control" id="sort-panel">
          <label for="shop-sort">Sort</label>
          <select id="shop-sort">
            <option value="default">Default order</option>
            <option value="az">A–Z</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <section class="wrap">
    <p class="count-line" id="shop-count" role="status">{kits.length} kits</p>
    <div class="cards" id="shop-grid">
      {kits.map((kit, index) => <KitCard kit={kit} eager={index < 4} />)}
    </div>
    <div class="no-results" id="shop-empty" hidden>
      <span class="sk">Nothing matches that combination</span>
      <p class="muted">Try a wider age range, or clear the collection filter.</p>
    </div>
  </section>

  <Testimonials title="What families are saying" />

  <section class="wrap sec">
    <div class="gift-meaning">
      <div class="gift-meaning-card">
        <img src="/images/logo-white-on-sage.png" alt="Raising Noble" />
        <span>Gift Card</span>
      </div>
      <div class="gift-meaning-copy">
        <p class="kicker">A thoughtful present</p>
        <h2>A Gift With Meaning</h2>
        <p>Looking for a thoughtful gift? Let them choose something meaningful to explore and enjoy together. Gift cards are delivered digitally by email.</p>
        <a class="btn" href="/gift-card">Give a gift card</a>
      </div>
    </div>
  </section>
</Layout>
