{
  "name": "raising-noble",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-catalogue.mjs && astro dev",
    "build": "node scripts/sync-catalogue.mjs && node scripts/write-headers.mjs && astro build",
    "preview": "wrangler dev",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint src scripts eslint.config.js",
    "test": "vitest run",
    "deploy": "wrangler d1 migrations apply raising-noble --remote && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@astrojs/check": "0.9.10",
    "astro": "5.18.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "eslint-plugin-astro": "1.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.4",
    "wrangler": "4.39.0"
  }
}
