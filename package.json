{
  "name": "raising-noble",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-catalogue.mjs && astro dev",
    "build": "node scripts/sync-catalogue.mjs && node scripts/write-headers.mjs && astro build",
    "preview": "wrangler dev",
    "check": "node scripts/sync-catalogue.mjs && astro check && tsc --noEmit",
    "lint": "eslint src scripts eslint.config.js",
    "test": "node scripts/sync-catalogue.mjs && vitest run",
    "deploy": "node scripts/sync-catalogue.mjs && wrangler d1 migrations apply raising-noble --remote --env=\"\" && wrangler deploy --env=\"\"",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "health": "node scripts/health.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "astro": "5.18.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "eslint-plugin-astro": "1.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.4",
    "wrangler": "4.39.0"
  }
}
